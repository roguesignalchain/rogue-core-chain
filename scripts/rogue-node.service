# Rogue Signal Headless Systemd Service
# Default mode: runs under the dedicated 'rogue' system user.
# Multi-user template mode: copy to /etc/systemd/system/rogue-node@.service,
# set User=%i and Environment="ROGUE_DATADIR=%h/.local/share/rogue-signal/chaindata",
# and enable with: sudo systemctl enable --now rogue-node@<username>.service
#
# HugePages (O-04): If enabling --randomx.fast, pre-allocate ~2.5 GB of 2MB huge pages:
#   sudo sysctl -w vm.nr_hugepages=1280
#   echo "vm.nr_hugepages=1280" | sudo tee /etc/sysctl.d/99-rogue-hugepages.conf

[Unit]
Description=Rogue Signal Headless Node (core-rogue)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rogue
Environment="ROGUE_DATADIR=/var/lib/rogue-signal/chaindata"
ExecStartPre=/usr/local/bin/core-rogue --rogue --datadir ${ROGUE_DATADIR} init
# Add --nat any or --nat extip:<PUBLIC_IP> if running behind UPnP or static NAT port forwarding (TCP/UDP 38888).
ExecStart=/usr/local/bin/core-rogue \
    --rogue \
    --datadir ${ROGUE_DATADIR} \
    --http \
    --http.addr 127.0.0.1 \
    --http.port 38845 \
    --http.api eth,net,web3,randomx \
    --port 38888 \
    --nat none \
    --syncmode full \
    --cache 256
Restart=always
RestartSec=5s
LimitNOFILE=65535
LimitMEMLOCK=infinity
TimeoutStopSec=30s
KillSignal=SIGTERM

# Security Hardening (MemoryDenyWriteExecute is intentionally omitted so RandomX JIT runs at native speed)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rogue-signal
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

